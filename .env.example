# Copy this file to .env and fill in real values. NEVER commit .env or put real secrets in this example file.

# --- AI (optional) ---
# Google Gemini API key. Without it, AI features show a clear message and manual entry still works.
GEMINI_API_KEY=
# Gemini model name (optional).
GEMINI_MODEL=gemini-2.5-flash

# --- Email (optional; without SMTP the Email reminders page acts as a demo outbox) ---
# For Gmail: host smtp.gmail.com, port 587, your address as user, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address shown in the From header (usually the same as SMTP_USER).
FROM_EMAIL=
# 1 = use STARTTLS on port 587 (recommended); 0 = plain. Port 465 always uses SSL.
SMTP_USE_TLS=1

# --- Reminders ---
# Secret for POST /api/reminders/run (header X-Reminder-Token). Use a long random string.
REMINDER_TOKEN=
# Timezone of the demo profile and default for new profiles.
APP_TIMEZONE=Asia/Kolkata

# --- Web / security ---
# Public URL of the app, used for links inside emails.
APP_URL=http://localhost:8000
# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Login session lifetime in hours.
SESSION_TTL=24

# --- Storage / tuning ---
# SQLite file path (default: carecircle.db in the project root; use a persistent disk path in production).
DATABASE_PATH=
# bcrypt cost factor (default 12; tests use 4).
BCRYPT_ROUNDS=12
# Set to 1 to disable the built-in once-a-minute scheduler (e.g. when only an external cron is used).
DISABLE_SCHEDULER=
